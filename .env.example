APP_URL=http://localhost:3000

# Neon Postgres — the only datastore. Use the pooled connection string.
DATABASE_URL=

# Clerk — authentication. Production needs a Clerk *production* instance;
# pk_test/sk_test keys belong to a development instance and are not valid on a
# custom domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

SESSION_ENCRYPTION_KEY=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
DEEPSEEK_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=FollowerSpike <audit@yourdomain.com>
RESEND_REPLY_TO_EMAIL=

# Razorpay subscriptions — current pricing ladder (Starter $19 / Pro $39 / Agency $79)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY_USD=
RAZORPAY_PLAN_STARTER_ANNUAL_USD=
RAZORPAY_PLAN_PRO_MONTHLY_USD=
RAZORPAY_PLAN_PRO_ANNUAL_USD=
RAZORPAY_PLAN_AGENCY_MONTHLY_USD=
RAZORPAY_PLAN_AGENCY_ANNUAL_USD=

# Plan IDs from the retired Essentials/Growth ladder. Kept so subscriptions sold
# under the old pricing keep resolving; safe to leave blank on a fresh setup.
RAZORPAY_PLAN_ESSENTIALS_MONTHLY_USD=
RAZORPAY_PLAN_GROWTH_MONTHLY_USD=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_SCALE=

# Spike Rank
# Bluesky Spike Rank needs no credentials — it reads the public AppView at
# public.api.bsky.app, which is why the tool can run ungated. Rank history is
# stored in profile_scores via DATABASE_URL; without it the rank still returns,
# it just is not recorded and no trend accumulates.

# Kill switch for automation, read by lib/admin/settings.ts and the admin console.
AUTOMATION_GLOBAL_PAUSED=false

# Clerk webhook signing secret (Clerk Dashboard -> Webhooks -> Signing Secret).
# Keeps the Neon users row in sync when a Clerk user changes email or is deleted.
CLERK_WEBHOOK_SIGNING_SECRET=

# Playwright end-to-end tests (npm run test:e2e). E2E_CLERK_USER_ID is a Clerk
# user in the development instance; the suite mints a sign-in ticket for it.
E2E_CLERK_USER_ID=
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=

# Upstash QStash — schedules /api/cron/dispatch and fans each due job out to
# /api/jobs/run as its own signed message. The signing keys are what authorize
# those two routes: with neither set they answer 401 to everything, which is
# deliberate — an unsigned job runner would be publicly executable. Local
# development needs none of this and drives the queue with `pnpm jobs:tick`.
# QSTASH_TOKEN is only needed to publish; without it the dispatcher runs the
# jobs it claimed inline instead.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
