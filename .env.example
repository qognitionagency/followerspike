APP_URL=http://localhost:3000

# Neon Postgres. Use the pooled connection string from the Neon console.
# Migrating off Supabase: DATABASE_URL is the target for all data access; the
# NEXT_PUBLIC_SUPABASE_* / service-role values below are still required by the
# auth flows and the tables not yet ported, and get deleted once that lands.
DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_ENCRYPTION_KEY=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
DEEPSEEK_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=FollowerSpike <audit@yourdomain.com>
RESEND_REPLY_TO_EMAIL=

# Razorpay subscriptions — current pricing ladder (Starter $19 / Pro $39 / Agency $79)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY_USD=
RAZORPAY_PLAN_STARTER_ANNUAL_USD=
RAZORPAY_PLAN_PRO_MONTHLY_USD=
RAZORPAY_PLAN_PRO_ANNUAL_USD=
RAZORPAY_PLAN_AGENCY_MONTHLY_USD=
RAZORPAY_PLAN_AGENCY_ANNUAL_USD=

# Plan IDs from the retired Essentials/Growth ladder. Kept so subscriptions sold
# under the old pricing keep resolving; safe to leave blank on a fresh setup.
RAZORPAY_PLAN_ESSENTIALS_MONTHLY_USD=
RAZORPAY_PLAN_GROWTH_MONTHLY_USD=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_SCALE=

# Spike Rank
# Bluesky Spike Rank needs no credentials — it reads the public AppView at
# public.api.bsky.app, which is why the tool can run ungated. Storing rank
# history (spike_rank_snapshots) uses DATABASE_URL above; without it the rank
# still returns, it just is not recorded and no trend accumulates.

# Automation worker
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
WORKER_ENDPOINT_URL=
WORKER_SHARED_SECRET=
AUTOMATION_GLOBAL_PAUSED=false
