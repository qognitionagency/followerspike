# The site's own origin, and the base for every canonical tag, Open Graph url,
# sitemap entry and robots host. Unset, the app falls back to Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL and then to localhost, so a deployment is never
# wrong by default — but set this to the custom domain, because the Vercel value
# is a *.vercel.app host and that is what would get indexed.
APP_URL=http://localhost:3000

# Google Analytics measurement id. Optional: with nothing here the analytics
# scripts are not rendered at all. It used to be hardcoded, which meant local
# development and preview deployments both reported into the production property.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Neon Postgres — the only datastore. Use the pooled connection string.
DATABASE_URL=

# Clerk — authentication. Production needs a Clerk *production* instance;
# pk_test/sk_test keys belong to a development instance and are not valid on a
# custom domain.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

SESSION_ENCRYPTION_KEY=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
DEEPSEEK_API_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=FollowerSpike <audit@yourdomain.com>
RESEND_REPLY_TO_EMAIL=

# Razorpay subscriptions — current pricing ladder (Starter $19 / Pro $39 / Agency $79)
# All six plan ids are required for checkout; there is no fallback to another
# plan, because the retired one mapped Agency onto the Pro plan id and would
# have charged the wrong amount. `pnpm billing:plans` reports which are missing
# and, with --create, makes them from the amounts in lib/constants.ts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY_USD=
RAZORPAY_PLAN_STARTER_ANNUAL_USD=
RAZORPAY_PLAN_PRO_MONTHLY_USD=
RAZORPAY_PLAN_PRO_ANNUAL_USD=
RAZORPAY_PLAN_AGENCY_MONTHLY_USD=
RAZORPAY_PLAN_AGENCY_ANNUAL_USD=

# Spike Rank
# Bluesky Spike Rank needs no credentials — it reads the public AppView at
# public.api.bsky.app, which is why the tool can run ungated. Rank history is
# stored in profile_scores via DATABASE_URL; without it the rank still returns,
# it just is not recorded and no trend accumulates.

# Kill switch for automation, read by lib/admin/settings.ts and the admin console.
AUTOMATION_GLOBAL_PAUSED=false

# Clerk webhook signing secret (Clerk Dashboard -> Webhooks -> Signing Secret).
# Keeps the Neon users row in sync when a Clerk user changes email or is deleted.
CLERK_WEBHOOK_SIGNING_SECRET=

# Playwright end-to-end tests (npm run test:e2e). E2E_CLERK_USER_ID is a Clerk
# user in the development instance; the suite mints a sign-in ticket for it.
E2E_CLERK_USER_ID=
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=

# Upstash QStash — schedules /api/cron/dispatch and fans each due job out to
# /api/jobs/run as its own signed message. The signing keys are what authorize
# those two routes: with neither set they answer 401 to everything, which is
# deliberate — an unsigned job runner would be publicly executable. Local
# development needs none of this and drives the queue with `pnpm jobs:tick`.
# QSTASH_TOKEN is only needed to publish; without it the dispatcher runs the
# jobs it claimed inline instead.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# X and LinkedIn OAuth apps.
#
# The connect flow lives at /api/connect/<platform>/start and returns to
# /api/connect/<platform>/callback. Register that callback URL exactly, on the
# custom domain, in each platform's developer console:
#
#   https://<your-domain>/api/connect/x/callback
#   https://<your-domain>/api/connect/linkedin/callback
#
# Scopes requested are tweet.read, tweet.write, users.read and offline.access on
# X, and openid, profile and w_member_social on LinkedIn. X gates write scopes
# behind a paid API tier and LinkedIn gates w_member_social behind app review,
# so both need approval before a connection can publish anything.
# Both adapters refuse to run without these rather
# than half-working: a user token cannot be issued without a registered app and
# cannot be refreshed without its secret, so a token stored against no app is
# one that dies at its first expiry with no way back. Bluesky needs nothing
# here — it authenticates with a per-user app password.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
